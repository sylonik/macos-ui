{
  "name": "@sylonikse/macos-ui",
  "version": "0.2.0",
  "description": "Authentic macOS-style React component library with copy-paste components. Built with TypeScript, Tailwind CSS, and React.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "client": "./dist/index.client.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./styles/*": "./dist/styles/*",
    "./tailwind.preset": "./tailwind.preset.js"
  },
  "files": [
    "dist",
    "cli",
    "src",
    "registry",
    "templates",
    "tailwind.preset.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "macos-ui": "./cli/dist/index.js"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build && tsup cli/index.ts --format esm --outDir cli/dist --no-dts --no-splitting",
    "build:cli": "tsup cli/index.ts --format esm --outDir cli/dist --no-dts --no-splitting",
    "prepublishOnly": "pnpm build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "docs:dev": "vitepress dev docs-vitepress",
    "docs:build": "node -e \"const{mkdirSync,copyFileSync}=require('fs');mkdirSync('docs-vitepress/public/registry',{recursive:true});copyFileSync('registry/components.json','docs-vitepress/public/registry/components.json')\" && vitepress build docs-vitepress",
    "docs:preview": "vitepress preview docs-vitepress",
    "deploy": "pnpm docs:build && npx wrangler deploy",
    "preview": "pnpm docs:build && npx wrangler dev"
  },
  "keywords": [
    "react",
    "components",
    "macos",
    "ui",
    "design-system",
    "tailwindcss",
    "typescript",
    "copy-paste",
    "component-library",
    "accessible",
    "a11y"
  ],
  "author": "Sylonik (https://sylonik.se)",
  "license": "MIT",
  "homepage": "https://ui.sylonik.se",
  "repository": {
    "type": "git",
    "url": "https://github.com/sylonik/macos-ui.git"
  },
  "bugs": {
    "url": "https://github.com/sylonik/macos-ui/issues",
    "email": "support@sylonik.dev"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.2",
    "prompts": "^2.4.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.2",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.0.8",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "^4.5.3",
    "globals": "^16.3.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.4.2",
    "tsup": "^8.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitepress": "^1.0.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.85.0"
  }
}
